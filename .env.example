# Only needed if you run the producer on your laptop instead of with "docker compose run tools".
# Local Docker Kafka needs no password. Never commit the real .env.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=order-events

# Optional: use a managed Kafka (e.g. Aiven) instead of the local one
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=
# KAFKA_CA_LOCATION=certs/ca.pem
# KAFKA_ADDRESS_FAMILY=v4
